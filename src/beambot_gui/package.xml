<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>beambot_gui</name>
  <version>0.0.1</version>
  <description>Graphical User Interface for beambot pipeline</description>
  <maintainer email="abondada@bnl.gov">abondada</maintainer>
  <license>BSD-3-Clause</license>

  <!-- ROS 2 dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Python dependencies -->
  <exec_depend>python3-pyqt6</exec_depend>
  <exec_depend>python3-pyqt6.qtwebengine</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Beambot framework and action interfaces -->
  <exec_depend>beambot</exec_depend>
  <exec_depend>beambot_interfaces</exec_depend>

  <!-- 3D viewer always serves the UR arm meshes -->
  <exec_depend>ur_description</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
