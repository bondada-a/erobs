# Goal
string target               # Pose name, SRDF state, or empty for relative moves
string planning_type        # "", "auto", "joint", "cartesian", "pilz", or "pilz_ptp"
string direction            # "forward", "backward", "left", "right", "up", "down"
float64 distance            # Distance in meters
float64[] cartesian_target  # [x,y,z] or [x,y,z,roll,pitch,yaw] — meters + degrees
string frame_id             # Reference frame for cartesian_target (default: "base_link")
string poses_json           # Pose definitions from task
string constraints_json     # Optional: JSON path constraints (empty = none)
string robot_model_revision # Orchestrator-managed; empty disables cross-goal model reuse
---
# Result
bool success
string error_message
---
# Feedback
