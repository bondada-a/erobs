build
install
log
recorded_bags/

# Environment files (may accumulate secrets)
.env
.env.*

# Python caches
__pycache__/
*.py[cod]

# Logs
*.log

# pytest
.pytest_cache/

#Pixi
pixi.lock

# End effector drivers (imported via vcs)
src/end_effectors/serial/
src/end_effectors/robotiq_hande_driver/
src/end_effectors/robotiq_hande_description/
src/end_effectors/ros2_epick_gripper/
src/end_effectors/pipettor/

# Vision packages (imported via vcs)
src/vision/*
!src/vision/README.md
!src/vision/vision.repos

# Survey bags are recorded at the repo root (run_survey.py --bag-out). Anchor to
# root so this doesn't swallow scripts/survey_mapping/ (the tooling itself).
/survey_*/

# Downloaded detector weights
yolov8n.pt

# Point cloud / mesh outputs from survey mapping (large, regenerable from bags)
*.ply
*.pcd

# Local Codex configuration.
/.codex/config.toml

# Ignore Claude Code files except the project-owned robot-operation skill.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/robot-operation/

# Ignore locally installed agent skills except the project-owned robot-operation skill.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/robot-operation/
skills-lock.json

# Training data (large files)
src/beambot/data/*
!src/beambot/data/yolo_dataset/
